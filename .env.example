# Connection settings for the local lab database. Throwaway values for a container that only
# listens on your own machine; copy to .env to change them.
PGHOST=localhost
PGPORT=55433
PGUSER=lab
PGPASSWORD=lab
PGDATABASE=lab

# Rows in the events table. The lesson uses 50,000,000 (about 12 GB on disk and an hour to load);
# the default keeps every lock effect visible and the whole lab to a few minutes.
ROWS=2000000
# Seconds of steady load before the first change (the lesson says ten minutes: 600).
BASELINE_SECONDS=60
